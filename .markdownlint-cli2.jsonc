// Markdown lint for this repo. CI: .github/workflows/sync-check.yml (markdownlint-cli2-action,
// pinned). Locally, the same tool and version: npx --yes markdownlint-cli2@0.23.2 "**/*.md"
// (add --fix for the auto-fixable rules; then run scripts/check-sync.sh, because a fix to a
// skill file has to be mirrored to its root reference copy and to demo-app's installed copy).
{
  "gitignore": true,                  // skips config.md, discovered-environment.md, dev.log, ...
  "ignores": [
    "demo-app/**",                    // submodule: its own repo, its own rules
    "**/node_modules/**",             // not ignored by default
    ".specify/**",                    // vendored Spec Kit templates and memory, never edited here
    ".claude/skills/speckit-*/**",    // vendored upstream skills, never edited here
    "uat/runs/**",                    // generated by UAT runs
    "uat/artifacts/**"
  ],
  "config": {
    "default": true,
    "MD013": false,                   // line-length: ~85-column prose is house style; spec tables run long
    "MD033": false,                   // no-inline-html: `<placeholder>` notation is house style
    "MD041": false,                   // first-line-heading: SKILL.md is frontmatter + instructions by design
    "MD024": { "siblings_only": true }, // no-duplicate-heading: same subheading under different parents is fine
    "MD040": false,                   // fenced-code-language: bare ``` fences are transcripts, not code
    "MD060": false                    // table-column-style: `| a |` headers over `|---|` separators are house style
  }
}
